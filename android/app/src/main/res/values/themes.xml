<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash de marca: fondo navy con el monograma centrado mientras carga
         el WebView (es instantaneo, pero evita el flash blanco al abrir). -->
    <style name="Theme.MvFbaIa" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">@color/navy_deep</item>
        <item name="android:navigationBarColor">@android:color/white</item>
    </style>
</resources>
