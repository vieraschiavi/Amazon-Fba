# ============================================================
#  MV FBA IA — configuracion de conexiones
#  Copia este archivo a `.env` y pega tus claves.
#  El archivo .env esta en .gitignore: NUNCA se sube al repo.
#  Tambien podes cargar las claves desde el panel (pestana Config).
# ============================================================

# --- Keepa (precio + BSR programatico, ~19 EUR/mes, sin free trial) ---
# keepa.com -> login -> Keepa API -> "Private API access key"
KEEPA_API_KEY=
KEEPA_DOMAIN=1                 # 1 = amazon.com (US)

# --- Asistente con IA (multi-proveedor, BYOK; todos opcionales) ---
# El asistente da CONSEJO sobre tus numeros; NO busca productos (eso es Keepa).
# Elegi tu proveedor. Recomendado: Claude (mejor razonamiento).
IA_PROVIDER=claude             # claude | openai | gemini
# Claude — console.anthropic.com -> API Keys -> Create Key
ANTHROPIC_API_KEY=
# OpenAI (ChatGPT) — platform.openai.com -> API keys
OPENAI_API_KEY=
# Google Gemini — aistudio.google.com -> Get API key
GEMINI_API_KEY=

# --- Gmail / SMTP (alertas reales por email; opcional) ---
# Requiere verificacion en 2 pasos + App Password (16 caracteres)
SMTP_USER=
SMTP_PASS=
ALERT_TO=vieraschiavi@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Keywords (Helium 10 Cerebro, via CSV) ---
CEREBRO_CSV_DIR=data/cerebro_exports
CEREBRO_MARKETPLACE=US
USAR_CEREBRO=1

# --- Parametros de pricing (defaults sensatos, editables) ---
REFERRAL_PCT=15
ACOS_PCT=10
TARGET_MARGIN=25
FBA_FEE_DEFAULT=3.65
UMBRAL_VERDE=25
UMBRAL_AMARILLO=12
