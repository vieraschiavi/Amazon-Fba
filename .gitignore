# Claves y secretos — NUNCA subir al repositorio
.env
*.env.local

# Base de datos local (se regenera sola con core/db.py)
fba.db
*.db
*.sqlite3

# Exports reales de Cerebro (datos propios del negocio)
data/cerebro_exports/*.csv

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Sistema
.DS_Store
Thumbs.db

# Instalador de Windows compilado (se genera en CI / con Inno Setup)
installer/Output/

# Runtime de Python embebido para el instalador (se descarga/arma en CI,
# ver .github/workflows/windows-installer.yml -- nunca se commitea)
runtime/

# Licencia del build owner (interno): CI la escribe desde secrets al compilar
# el instalador del dueño. Contiene una clave real -- NUNCA se commitea.
owner_licencia.json

# Assets de la app Android que se copian en cada build desde mobile/
android/app/src/main/assets/
landing/app/

# Electron: dependencias y salida del empaquetado (los arma el CI)
electron/node_modules/
electron-dist/
webview2/
