{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "sh scripts/vercel-build.sh",
  "outputDirectory": "landing",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/demo-registro", "destination": "/api/creditos" }
  ],
  "crons": [
    { "path": "/api/cron-recordatorio-demo", "schedule": "0 15 * * *" }
  ]
}
